Algoritmo "tipos_primitivos"

Var
   quantidadeFilhos : inteiro
   valorCombustivel : real
   identificacaoCarro : caractere
   luzAcesa : logico
   distanciaLuaTerra : inteiro
   inicialNome : caractere

Inicio
   quantidadeFilhos <- 2
   valorCombustivel <- 5.89
   identificacaoCarro <- "BRA2E19"
   luzAcesa <- VERDADEIRO
   distanciaLuaTerra <- 384400
   inicialNome <- "R"

   escreval("Quantidade de filhos: ", quantidadeFilhos)
   escreval("Valor da gasolina: R$ ", valorCombustivel:4:2)
   escreval("Identificacao do carro: ", identificacaoCarro)
   escreval("A luz esta acesa? ", luzAcesa)
   escreval("Distancia Lua-Terra: ", distanciaLuaTerra, " km")
   escreval("Inicial do nome: ", inicialNome)
Fimalgoritmo